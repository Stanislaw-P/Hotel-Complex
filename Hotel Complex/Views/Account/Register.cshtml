@model RegisterViewModel

@{
    ViewData["Title"] = "Регистрация";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Гостиничный комплекс</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/hotel-theme.css" />
    <link rel="stylesheet" href="~/css/auth.css" />
</head>
<body class="auth-page">
    <!-- Градиентные наложения -->
    <div class="gradient-overlay"></div>
    <div class="top-glow"></div>
    <div class="bottom-glow"></div>

    <!-- Декоративные элементы -->
    <div class="auth-decoration">
        <i class="bi bi-building"></i>
    </div>
    <div class="auth-decoration" style="bottom: auto; top: 20px; left: 20px; right: auto;">
        <i class="bi bi-person-plus"></i>
    </div>

    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card auth-card">
                    <div class="auth-header text-center py-4">
                        <i class="bi bi-person-plus auth-icon"></i>
                        <h3 class="auth-title mt-2 mb-0">Регистрация</h3>
                        <p class="auth-subtitle mb-0">Создайте новый аккаунт</p>
                    </div>

                    <div class="card-body p-4">
                        <form asp-action="Register" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="LastName" class="auth-label">
                                        <i class="bi bi-person me-1"></i> Фамилия
                                    </label>
                                    <input asp-for="LastName" class="auth-input form-control"
                                           placeholder="Иванов" />
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="FirstName" class="auth-label">
                                        <i class="bi bi-person me-1"></i> Имя
                                    </label>
                                    <input asp-for="FirstName" class="auth-input form-control"
                                           placeholder="Иван" />
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="MiddleName" class="auth-label">
                                    <i class="bi bi-person-badge me-1"></i> Отчество
                                </label>
                                <input asp-for="MiddleName" class="auth-input form-control"
                                       placeholder="Иванович (необязательно)" />
                                <span asp-validation-for="MiddleName" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Email" class="auth-label">
                                    <i class="bi bi-envelope me-1"></i> Email
                                </label>
                                <input asp-for="Email" class="auth-input form-control"
                                       placeholder="ivanov@mail.com" type="email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Phone" class="auth-label">
                                    <i class="bi bi-telephone me-1"></i> Телефон
                                </label>
                                <input asp-for="Phone" class="auth-input form-control"
                                       placeholder="+7 (999) 123-45-67" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="auth-label">
                                    <i class="bi bi-lock me-1"></i> Пароль
                                </label>
                                <input asp-for="Password" class="auth-input form-control"
                                       type="password" placeholder="Минимум 6 символов" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                                <small class="text-muted">
                                    <i class="bi bi-info-circle"></i> Пароль должен содержать минимум 6 символов
                                </small>
                            </div>

                            <div class="mb-4">
                                <label asp-for="ConfirmPassword" class="auth-label">
                                    <i class="bi bi-lock-fill me-1"></i> Подтверждение пароля
                                </label>
                                <input asp-for="ConfirmPassword" class="auth-input form-control"
                                       type="password" placeholder="Повторите пароль" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>

                            <button type="submit" class="auth-btn">
                                <i class="bi bi-person-plus me-2"></i>Зарегистрироваться
                            </button>

                            <div class="auth-divider my-4">
                                <span>уже есть аккаунт?</span>
                            </div>

                            <div class="text-center">
                                <a asp-action="Login" class="auth-link">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Войти в систему
                                </a>
                            </div>
                        </form>
                    </div>

                    <div class="card-footer text-center py-3" style="background: rgba(248, 249, 250, 0.9);">
                        <small class="text-muted">
                            СОГУ 2026
                            <i class="bi bi-star ms-1"></i>
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>