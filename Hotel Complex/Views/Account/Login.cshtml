@model LoginViewModel

@{
    ViewData["Title"] = "Вход в систему";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Гостиничный комплекс</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/hotel-theme.css" />
    <link rel="stylesheet" href="~/css/auth.css" />
</head>
<body class="auth-page">
    <!-- Градиентные наложения -->
    <div class="gradient-overlay"></div>
    <div class="top-glow"></div>
    <div class="bottom-glow"></div>

    <!-- Декоративные элементы -->
    <div class="auth-decoration">
        <i class="bi bi-building"></i>
    </div>
    <div class="auth-decoration" style="bottom: auto; top: 20px; left: 20px; right: auto;">
        <i class="bi bi-geo-alt"></i>
    </div>

    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-md-5">
                <div class="card auth-card">
                    <div class="auth-header text-center py-4">
                        <i class="bi bi-building auth-icon"></i>
                        <h3 class="auth-title mt-2 mb-0">Гостиничный комплекс</h3>
                        <p class="auth-subtitle mb-0">Добро пожаловать в систему управления</p>
                    </div>

                    <div class="card-body p-4">
                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }

                        <form asp-action="Login" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="mb-3">
                                <label asp-for="Email" class="auth-label">
                                    <i class="bi bi-envelope me-1"></i> Электронная почта
                                </label>
                                <input asp-for="Email" class="auth-input form-control"
                                       placeholder="admin@hotel.com" autocomplete="off" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="auth-label">
                                    <i class="bi bi-lock me-1"></i> Пароль
                                </label>
                                <input asp-for="Password" class="auth-input form-control"
                                       type="password" placeholder="••••••" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <div class="mb-4 form-check">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label text-muted">
                                    Запомнить меня
                                </label>
                            </div>

                            <button type="submit" class="auth-btn">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Войти
                            </button>

                            <div class="auth-divider my-4">
                                <span>или</span>
                            </div>

                            <div class="text-center">
                                <span class="text-muted">Нет аккаунта?</span>
                                <a asp-action="Register" class="auth-link ms-1">
                                    Зарегистрироваться <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </form>
                    </div>

                    <div class="card-footer text-center py-3" style="background: rgba(248, 249, 250, 0.9);">
                        <small class="text-muted">
                            СОГУ 2026
                            <i class="bi bi-star ms-1"></i>
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>