<!-- Views/ServiceOrder/Success.cshtml -->
@{
    ViewData["Title"] = "Услуга заказана";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="quick-actions-card">
                <div class="mb-4">
                    <i class="bi bi-check-circle-fill" style="font-size: 5rem; color: #28a745;"></i>
                </div>

                <h2 class="mb-3" style="color: #721e1e;">Услуга успешно заказана!</h2>
                <p class="lead mb-4">Ваш заказ принят в обработку</p>

                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i>
                    Стоимость услуги будет добавлена к вашему счету.
                </div>

                <div class="mt-4">
                    <a href="/PublicHome/Index" class="action-btn">
                        <i class="bi bi-house"></i> На главную
                    </a>
                    <a href="/ServiceOrder/Create" class="action-btn action-btn-outline ms-2">
                        <i class="bi bi-cart-plus"></i> Заказать еще
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>