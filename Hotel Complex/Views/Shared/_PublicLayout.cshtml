<!-- Views/Shared/_PublicLayout.cshtml -->
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Гостиничный комплекс</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/hotel-theme.css" />
</head>
<body class="auth-page">
    <div class="gradient-overlay"></div>
    <div class="top-glow"></div>

    <nav class="navbar navbar-expand-lg navbar-dark" style="background: rgba(114, 30, 30, 0.9); backdrop-filter: blur(10px);">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "PublicHome")">
                <i class="bi bi-building"></i> Гостиничный комплекс
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "PublicHome")">
                            <i class="bi bi-house"></i> Главная
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "PublicBooking")">
                            <i class="bi bi-calendar-check"></i> Бронирование
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "ServiceOrder")">
                            <i class="bi bi-grid"></i> Дополнительные услуги
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Login", "Account")">
                            <i class="bi bi-box-arrow-in-right"></i> Вход
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    

    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-column">
                    <h4 class="footer-title">
                        <i class="bi bi-building me-2"></i>О нас
                    </h4>
                    <p style="color: var(--secondary-sand); opacity: 0.9; line-height: 1.6;">
                        Горный гостиничный комплекс с супер красивым видом на горы.
                        Комфорт и уют для наших гостей.
                    </p>
                    <div class="social-links">
                        <a href="#"><i class="bi bi-facebook"></i></a>
                        <a href="#"><i class="bi bi-instagram"></i></a>
                        <a href="#"><i class="bi bi-telegram"></i></a>
                        <a href="#"><i class="bi bi-whatsapp"></i></a>
                    </div>
                </div>

                <div class="footer-column">
                    <h4 class="footer-title">
                        <i class="bi bi-link me-2"></i>Быстрые ссылки
                    </h4>
                    <ul class="footer-links">
                        <li><a href="@Url.Action("Index", "Rooms")"><i class="bi bi-chevron-right"></i> Номера</a></li>
                        <li><a href="#"><i class="bi bi-chevron-right"></i> Бронирование</a></li>
                        <li><a href="#"><i class="bi bi-chevron-right"></i> Услуги</a></li>
                        <li><a href="#"><i class="bi bi-chevron-right"></i> Контакты</a></li>
                        <li><a href="#"><i class="bi bi-chevron-right"></i> Отели</a></li>
                    </ul>
                </div>

                <div class="footer-column">
                    <h4 class="footer-title">
                        <i class="bi bi-clock me-2"></i>Режим работы
                    </h4>
                    <div class="footer-contact">
                        <i class="bi bi-calendar-check"></i>
                        <span>Ежедневно: 24/7</span>
                    </div>
                    <div class="footer-contact">
                        <i class="bi bi-clock"></i>
                        <span>Круглосуточная регистрация</span>
                    </div>
                </div>

                <div class="footer-column">
                    <h4 class="footer-title">
                        <i class="bi bi-geo-alt me-2"></i>Контакты
                    </h4>
                    <div class="footer-contact">
                        <i class="bi bi-geo-alt"></i>
                        <span>Дигорское ущелье, 42</span>
                    </div>
                    <div class="footer-contact">
                        <i class="bi bi-telephone"></i>
                        <span>+7 (999) 123-45-67</span>
                    </div>
                    <div class="footer-contact">
                        <i class="bi bi-envelope"></i>
                        <span>info@hotelcomplex.ru</span>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <div class="row">
                    <div class="col-md-6 text-md-start">
                        <i class="bi bi-building me-2"></i>
                        &copy; @DateTime.Now.Year - Гостиничный комплекс. Все права защищены.
                    </div>
                    <div class="col-md-6 text-md-end">
                        <i class="bi bi-star-fill me-1" style="color: var(--secondary-sand);"></i>
                        <span>Лучше не найдете</span>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>