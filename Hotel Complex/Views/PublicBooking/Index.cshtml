@{
    ViewData["Title"] = "Бронирование номера";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<!-- Статические данные номеров -->
@{
    var rooms = new[]
    {
        new { Id = 101, RoomNumber = 101, Floor = 1, RoomTypeName = "Стандарт", Capacity = 2, BasePrice = 2500, Status = "free", Description = "Уютный стандартный номер с видом на горы" },
        new { Id = 102, RoomNumber = 102, Floor = 1, RoomTypeName = "Стандарт", Capacity = 2, BasePrice = 2500, Status = "free", Description = "Светлый номер с большой кроватью" },
        new { Id = 103, RoomNumber = 103, Floor = 1, RoomTypeName = "Стандарт+", Capacity = 2, BasePrice = 3000, Status = "occupied", Description = "Улучшенный стандарт с дополнительным пространством" },
        new { Id = 201, RoomNumber = 201, Floor = 2, RoomTypeName = "Полулюкс", Capacity = 3, BasePrice = 4000, Status = "free", Description = "Просторный полулюкс с гостиной зоной" },
        new { Id = 202, RoomNumber = 202, Floor = 2, RoomTypeName = "Полулюкс", Capacity = 3, BasePrice = 4000, Status = "free", Description = "Семейный полулюкс с двумя спальнями" },
        new { Id = 203, RoomNumber = 203, Floor = 2, RoomTypeName = "Полулюкс+", Capacity = 3, BasePrice = 4500, Status = "cleaning", Description = "Полулюкс премиум с видом на горы" },
        new { Id = 301, RoomNumber = 301, Floor = 3, RoomTypeName = "Люкс", Capacity = 4, BasePrice = 6500, Status = "free", Description = "Роскошный люкс с панорамным видом" },
        new { Id = 302, RoomNumber = 302, Floor = 3, RoomTypeName = "Люкс", Capacity = 4, BasePrice = 7000, Status = "free", Description = "Люкс с джакузи и террасой" },
        new { Id = 401, RoomNumber = 401, Floor = 4, RoomTypeName = "Апартаменты", Capacity = 5, BasePrice = 10000, Status = "free", Description = "Двухуровневые апартаменты с камином" },
        new { Id = 402, RoomNumber = 402, Floor = 4, RoomTypeName = "Апартаменты", Capacity = 5, BasePrice = 12000, Status = "free", Description = "Президентские апартаменты с сауной" }
    };
}

<div class="container py-4">
    <div class="text-center mb-5">
        <h1 class="display-4" style="color: #721e1e;">
            <i class="bi bi-calendar-heart"></i> Бронирование номера
        </h1>
        <p class="lead">Выберите идеальный номер для вашего отдыха в горах</p>
    </div>

    <!-- Форма поиска -->
    <div class="quick-actions-card mb-5">
        <h3 class="quick-actions-title text-center">
            <i class="bi bi-search"></i> Поиск свободных номеров
        </h3>

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label fw-bold">
                    <i class="bi bi-calendar-check"></i> Дата заезда
                </label>
                <input type="date" id="searchCheckIn" class="form-control"
                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                       value="@DateTime.Today.ToString("yyyy-MM-dd")">
            </div>

            <div class="col-md-4">
                <label class="form-label fw-bold">
                    <i class="bi bi-calendar-x"></i> Дата выезда
                </label>
                <input type="date" id="searchCheckOut" class="form-control"
                       value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")">
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">
                    <i class="bi bi-people"></i> Количество гостей
                </label>
                <select id="searchCapacity" class="form-select">
                    <option value="1">1 гость</option>
                    <option value="2" selected>2 гостя</option>
                    <option value="3">3 гостя</option>
                    <option value="4">4 гостя</option>
                    <option value="5">5 гостей</option>
                </select>
            </div>

            <div class="col-md-1 d-flex align-items-end">
                <button onclick="searchRooms()" class="action-btn w-100">
                    <i class="bi bi-search"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Фильтры -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="d-flex flex-wrap gap-2 justify-content-center">
                <button onclick="filterByType('all')" class="filter-btn active" data-filter="all">
                    Все номера
                </button>
                <button onclick="filterByType('Стандарт')" class="filter-btn" data-filter="Стандарт">
                    Стандарт
                </button>
                <button onclick="filterByType('Полулюкс')" class="filter-btn" data-filter="Полулюкс">
                    Полулюкс
                </button>
                <button onclick="filterByType('Люкс')" class="filter-btn" data-filter="Люкс">
                    Люкс
                </button>
                <button onclick="filterByType('Апартаменты')" class="filter-btn" data-filter="Апартаменты">
                    Апартаменты
                </button>
            </div>
        </div>
    </div>

    <!-- Результаты поиска -->
    <div id="searchResults">
        <div class="row" id="roomsContainer">
            @foreach (var room in rooms)
            {
                <div class="col-md-6 col-lg-4 mb-4 room-card" data-type="@room.RoomTypeName" data-status="@room.Status" data-capacity="@room.Capacity">
                    <div class="feature-card h-100 @(room.Status != "free" ? "opacity-50" : "")">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h3 class="feature-title mb-0" style="font-size: 1.8rem;">
                                        № @room.RoomNumber
                                    </h3>
                                    <span class="badge mt-2" style="background: #721e1e; color: #e2d797;">
                                        @room.RoomTypeName
                                    </span>
                                </div>
                                @if (room.Status == "free")
                                {
                                    <span class="badge-available">Свободен</span>
                                }
                                else if (room.Status == "occupied")
                                {
                                    <span class="badge-occupied">Занят</span>
                                }
                                else if (room.Status == "cleaning")
                                {
                                    <span class="badge-cleaning">На уборке</span>
                                }
                            </div>

                            <p class="text-muted mb-3">@room.Description</p>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-2">
                                    <span><i class="bi bi-arrow-up"></i> Этаж: @room.Floor</span>
                                    <span><i class="bi bi-people"></i> Вместимость: @room.Capacity чел.</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span><i class="bi bi-wifi"></i> Wi-Fi</span>
                                    <span><i class="bi bi-tv"></i> Телевизор</span>
                                    <span><i class="bi bi-droplet"></i> Душ</span>
                                </div>
                            </div>

                            <div class="mt-3 pt-2 border-top">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <small class="text-muted">Цена за сутки</small>
                                        <h4 class="mb-0" style="color: #721e1e;">
                                            @room.BasePrice.ToString("N0") ₽
                                        </h4>
                                    </div>
                                    @if (room.Status == "free")
                                    {
                                        <a href="/PublicBooking/Book?roomId=@room.Id&checkIn=@DateTime.Today.ToString("yyyy-MM-dd")&checkOut=@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                                           class="action-btn">
                                            Выбрать <i class="bi bi-arrow-right"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <button class="action-btn" disabled style="opacity: 0.5; cursor: not-allowed;">
                                            Недоступен
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Если нет результатов -->
    <div id="noResults" class="text-center py-5" style="display: none;">
        <i class="bi bi-emoji-frown" style="font-size: 4rem; color: #721e1e;"></i>
        <h3 class="mt-3">Нет доступных номеров</h3>
        <p class="text-muted">На выбранные даты нет свободных номеров. Попробуйте изменить даты.</p>
        <button onclick="resetFilters()" class="action-btn mt-3">
            <i class="bi bi-arrow-repeat"></i> Сбросить фильтры
        </button>
    </div>
</div>

<style>
    .filter-btn {
        padding: 8px 20px;
        border: 2px solid #721e1e;
        background: transparent;
        color: #721e1e;
        border-radius: 50px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .filter-btn:hover,
        .filter-btn.active {
            background: #721e1e;
            color: #e2d797;
        }

    .badge-available {
        background-color: #28a745;
        color: white;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 500;
    }

    .badge-occupied {
        background-color: #dc3545;
        color: white;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 500;
    }

    .badge-cleaning {
        background-color: #ffc107;
        color: #212529;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 500;
    }

    .opacity-50 {
        opacity: 0.6;
    }
</style>

@section Scripts {
    <script>
        // Установка минимальных дат
        var today = new Date().toISOString().split('T')[0];
        var searchCheckIn = document.getElementById('searchCheckIn');
        var searchCheckOut = document.getElementById('searchCheckOut');

        if (searchCheckIn) {
            searchCheckIn.min = today;

            searchCheckIn.addEventListener('change', function() {
                searchCheckOut.min = this.value;
                if (searchCheckOut.value <= this.value) {
                    searchCheckOut.value = this.value;
                }
                searchRooms();
            });

            searchCheckOut.addEventListener('change', function() {
                searchRooms();
            });
        }

        var currentFilter = 'all';

        function searchRooms() {
            var checkIn = document.getElementById('searchCheckIn').value;
            var checkOut = document.getElementById('searchCheckOut').value;
            var capacity = parseInt(document.getElementById('searchCapacity').value);

            var rooms = document.querySelectorAll('.room-card');
            var hasVisible = false;

            rooms.forEach(function(room) {
                var roomCapacity = parseInt(room.dataset.capacity);
                var roomStatus = room.dataset.status;
                var roomType = room.dataset.type;

                var matchesCapacity = roomCapacity >= capacity;
                var matchesStatus = roomStatus === 'free';
                var matchesType = currentFilter === 'all' || roomType === currentFilter;

                if (matchesCapacity && matchesStatus && matchesType) {
                    room.style.display = '';
                    hasVisible = true;
                } else {
                    room.style.display = 'none';
                }
            });

            // Показываем сообщение если нет результатов
            var noResults = document.getElementById('noResults');
            if (hasVisible) {
                noResults.style.display = 'none';
            } else {
                noResults.style.display = 'block';
            }
        }

        function filterByType(type) {
            currentFilter = type;

            // Обновляем активную кнопку
            document.querySelectorAll('.filter-btn').forEach(function(btn) {
                btn.classList.remove('active');
            });
            event.target.classList.add('active');

            searchRooms();
        }

        function resetFilters() {
            currentFilter = 'all';
            document.querySelectorAll('.filter-btn').forEach(function(btn) {
                btn.classList.remove('active');
                if (btn.dataset.filter === 'all') {
                    btn.classList.add('active');
                }
            });

            document.getElementById('searchCheckIn').value = today;
            document.getElementById('searchCheckOut').value = getTomorrow();
            document.getElementById('searchCapacity').value = '2';

            searchRooms();
        }

        function getTomorrow() {
            var tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            return tomorrow.toISOString().split('T')[0];
        }

        // Поиск при загрузке
        searchRooms();
    </script>
}