@{
    ViewData["Title"] = "Управление бронированиями";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Статические данные бронирований -->
@{
    var bookings = new[]
    {
        new { Id = 1001, GuestName = "Иванов Иван Иванович", RoomNumber = 101, RoomType = "Стандарт", CheckIn = "2024-05-10", CheckOut = "2024-05-15", Nights = 5, TotalPrice = 12500, Prepayment = 5000, Status = "completed", CreatedAt = "2024-05-01", Phone = "+7 (999) 123-45-67" },
        new { Id = 1002, GuestName = "Петрова Анна Сергеевна", RoomNumber = 201, RoomType = "Полулюкс", CheckIn = "2024-05-15", CheckOut = "2024-05-20", Nights = 5, TotalPrice = 20000, Prepayment = 10000, Status = "confirmed", CreatedAt = "2024-05-10", Phone = "+7 (999) 234-56-78" },
        new { Id = 1003, GuestName = "Сидоров Алексей Владимирович", RoomNumber = 301, RoomType = "Люкс", CheckIn = "2024-05-20", CheckOut = "2024-05-25", Nights = 5, TotalPrice = 32500, Prepayment = 15000, Status = "confirmed", CreatedAt = "2024-05-15", Phone = "+7 (999) 345-67-89" },
        new { Id = 1004, GuestName = "Козлова Елена Дмитриевна", RoomNumber = 102, RoomType = "Стандарт", CheckIn = "2024-05-01", CheckOut = "2024-05-07", Nights = 6, TotalPrice = 15000, Prepayment = 5000, Status = "completed", CreatedAt = "2024-04-25", Phone = "+7 (999) 456-78-90" },
        new { Id = 1005, GuestName = "Смирнов Дмитрий Андреевич", RoomNumber = 202, RoomType = "Полулюкс", CheckIn = "2024-06-01", CheckOut = "2024-06-05", Nights = 4, TotalPrice = 16000, Prepayment = 8000, Status = "confirmed", CreatedAt = "2024-05-20", Phone = "+7 (999) 567-89-01" },
        new { Id = 1006, GuestName = "Морозова Ольга Павловна", RoomNumber = 302, RoomType = "Люкс", CheckIn = "2024-06-10", CheckOut = "2024-06-15", Nights = 5, TotalPrice = 35000, Prepayment = 10000, Status = "pending", CreatedAt = "2024-05-25", Phone = "+7 (999) 678-90-12" },
        new { Id = 1007, GuestName = "Новиков Павел Игоревич", RoomNumber = 103, RoomType = "Стандарт+", CheckIn = "2024-05-25", CheckOut = "2024-05-28", Nights = 3, TotalPrice = 9000, Prepayment = 3000, Status = "cancelled", CreatedAt = "2024-05-22", Phone = "+7 (999) 789-01-23" },
        new { Id = 1008, GuestName = "Федорова Татьяна Алексеевна", RoomNumber = 203, RoomType = "Полулюкс+", CheckIn = "2024-06-15", CheckOut = "2024-06-20", Nights = 5, TotalPrice = 22500, Prepayment = 10000, Status = "confirmed", CreatedAt = "2024-05-28", Phone = "+7 (999) 890-12-34" },
        new { Id = 1009, GuestName = "Волков Сергей Михайлович", RoomNumber = 401, RoomType = "Апартаменты", CheckIn = "2024-07-01", CheckOut = "2024-07-07", Nights = 6, TotalPrice = 60000, Prepayment = 20000, Status = "confirmed", CreatedAt = "2024-06-01", Phone = "+7 (999) 901-23-45" },
        new { Id = 1010, GuestName = "Зайцева Мария Николаевна", RoomNumber = 204, RoomType = "Полулюкс", CheckIn = "2024-06-20", CheckOut = "2024-06-25", Nights = 5, TotalPrice = 20000, Prepayment = 5000, Status = "pending", CreatedAt = "2024-06-05", Phone = "+7 (999) 012-34-56" }
    };
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="section-title mb-0">
            <i class="bi bi-calendar-check-fill"></i> Управление бронированиями
        </h2>
        <a href="/Admin/Bookings/Create" class="action-btn">
            <i class="bi bi-plus-circle"></i> Создать бронирование
        </a>
    </div>

    <!-- Карточки статистики -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="card-header">
                    <i class="bi bi-calendar"></i> Всего броней
                </div>
                <div class="card-body text-center">
                    <div class="stat-number">@bookings.Length</div>
                    <div class="stat-label">всего</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="card-header">
                    <i class="bi bi-check-circle"></i> Активные
                </div>
                <div class="card-body text-center">
                    <div class="stat-number">@bookings.Count(b => b.Status == "confirmed")</div>
                    <div class="stat-label">подтверждено</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="card-header">
                    <i class="bi bi-hourglass-split"></i> Ожидают
                </div>
                <div class="card-body text-center">
                    <div class="stat-number">@bookings.Count(b => b.Status == "pending")</div>
                    <div class="stat-label">на рассмотрении</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="card-header">
                    <i class="bi bi-currency-dollar"></i> Выручка
                </div>
                <div class="card-body text-center">
                    <div class="stat-number">@bookings.Sum(b => b.TotalPrice).ToString("N0")</div>
                    <div class="stat-label">всего ₽</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Фильтры и поиск -->
    <div class="quick-actions-card mb-4">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label fw-bold">
                    <i class="bi bi-search"></i> Поиск
                </label>
                <input type="text" id="searchInput" class="form-control" placeholder="Гость, телефон, номер...">
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">
                    <i class="bi bi-funnel"></i> Статус
                </label>
                <select id="statusFilter" class="form-select">
                    <option value="all">Все статусы</option>
                    <option value="confirmed">Подтверждено</option>
                    <option value="pending">На рассмотрении</option>
                    <option value="completed">Завершено</option>
                    <option value="cancelled">Отменено</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">
                    <i class="bi bi-door-open"></i> Тип номера
                </label>
                <select id="typeFilter" class="form-select">
                    <option value="all">Все типы</option>
                    <option value="Стандарт">Стандарт</option>
                    <option value="Полулюкс">Полулюкс</option>
                    <option value="Люкс">Люкс</option>
                    <option value="Апартаменты">Апартаменты</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">
                    <i class="bi bi-sort-down"></i> Сортировка
                </label>
                <select id="sortSelect" class="form-select">
                    <option value="dateNew">Сначала новые</option>
                    <option value="dateOld">Сначала старые</option>
                    <option value="priceHigh">По цене (дорогие)</option>
                    <option value="priceLow">По цене (дешевые)</option>
                    <option value="guest">По гостю (А-Я)</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="action-btn-outline w-100" onclick="resetFilters()">
                    <i class="bi bi-arrow-repeat"></i> Сбросить фильтры
                </button>
            </div>
        </div>
    </div>

    <!-- Таблица бронирований -->
    <div class="table-responsive">
        <table class="table table-custom table-hover" id="bookingsTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Гость</th>
                    <th>Номер</th>
                    <th>Тип</th>
                    <th>Дата заезда</th>
                    <th>Дата выезда</th>
                    <th>Ночей</th>
                    <th>Сумма</th>
                    <th>Предоплата</th>
                    <th>Статус</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in bookings)
                {
                    <tr data-id="@booking.Id" data-guest="@booking.GuestName" data-room="@booking.RoomNumber" data-status="@booking.Status" data-type="@booking.RoomType" data-price="@booking.TotalPrice" data-date="@booking.CheckIn">
                        <td>#@booking.Id</td>
                        <td>
                            <strong>@booking.GuestName</strong>
                            <br />
                            <small class="text-muted">@booking.Phone</small>
                        </td>
                        <td>№@booking.RoomNumber</td>
                        <td>@booking.RoomType</td>
                        <td>@DateTime.Parse(booking.CheckIn).ToString("dd.MM.yyyy")</td>
                        <td>@DateTime.Parse(booking.CheckOut).ToString("dd.MM.yyyy")</td>
                        <td>@booking.Nights</td>
                        <td class="text-end">@booking.TotalPrice.ToString("N0") ₽</td>
                        <td class="text-end">@booking.Prepayment.ToString("N0") ₽</td>
                        <td>
                            @if (booking.Status == "confirmed")
                            {
                                <span class="badge bg-success">Подтверждено</span>
                            }
                            else if (booking.Status == "pending")
                            {
                                <span class="badge bg-warning text-dark">На рассмотрении</span>
                            }
                            else if (booking.Status == "completed")
                            {
                                <span class="badge bg-secondary">Завершено</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Отменено</span>
                            }
                        </td>
                        <td>
                            <a href="/Admin/Bookings/Details/@booking.Id" class="btn btn-sm btn-info me-1" title="Просмотр">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a href="/Admin/Bookings/Edit/@booking.Id" class="btn btn-sm btn-warning me-1" title="Редактировать">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <button type="button" class="btn btn-sm btn-danger" title="Отменить" onclick="cancelBooking(@booking.Id, '@booking.GuestName')">
                                <i class="bi bi-x-circle"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Пагинация -->
    <div class="d-flex justify-content-center mt-4">
        <nav>
            <ul class="pagination" id="pagination">
                <!-- Пагинация через JS -->
            </ul>
        </nav>
    </div>
</div>

<!-- Модальное окно отмены бронирования -->
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background: #dc3545; color: white;">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle-fill"></i> Отмена бронирования
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Вы уверены, что хотите отменить бронирование для гостя <strong id="cancelGuestName"></strong>?</p>
                <p class="text-danger">Номер будет освобожден и станет доступен для других гостей.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="action-btn action-btn-outline" data-bs-dismiss="modal">Нет, закрыть</button>
                <button type="button" class="action-btn" style="background: #dc3545;" id="confirmCancel">Да, отменить</button>
            </div>
        </div>
    </div>
</div>

<script>
    let currentData = [];
    let filteredData = [];
    let currentPage = 1;
    const itemsPerPage = 10;
    let cancelId = null;

    // Инициализация данных
    function initData() {
        const rows = document.querySelectorAll('#bookingsTable tbody tr');
        currentData = Array.from(rows).map(row => ({
            element: row,
            id: parseInt(row.dataset.id),
            guest: row.dataset.guest,
            room: row.dataset.room,
            status: row.dataset.status,
            type: row.dataset.type,
            price: parseFloat(row.dataset.price),
            date: row.dataset.date
        }));
        filteredData = [...currentData];
        applySort();
        updateTableDisplay();
    }

    function updateTableDisplay() {
        const start = (currentPage - 1) * itemsPerPage;
        const end = start + itemsPerPage;
        const pageData = filteredData.slice(start, end);

        currentData.forEach(item => { item.element.style.display = 'none'; });
        pageData.forEach(item => { item.element.style.display = ''; });

        updatePagination();
    }

    function updatePagination() {
        const totalPages = Math.ceil(filteredData.length / itemsPerPage);
        const pagination = document.getElementById('pagination');
        if (totalPages <= 1) { pagination.innerHTML = ''; return; }

        let html = `<li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                        <a class="page-link" href="#" onclick="changePage(${currentPage - 1}); return false;">«</a>
                    </li>`;

        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) {
                html += `<li class="page-item ${i === currentPage ? 'active' : ''}">
                            <a class="page-link" href="#" onclick="changePage(${i}); return false;">${i}</a>
                        </li>`;
            } else if (i === currentPage - 3 || i === currentPage + 3) {
                html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }
        }

        html += `<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                    <a class="page-link" href="#" onclick="changePage(${currentPage + 1}); return false;">»</a>
                </li>`;
        pagination.innerHTML = html;
    }

    function changePage(page) {
        const totalPages = Math.ceil(filteredData.length / itemsPerPage);
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        updateTableDisplay();
    }

    function applyFilters() {
        const searchTerm = document.getElementById('searchInput').value.toLowerCase();
        const statusFilter = document.getElementById('statusFilter').value;
        const typeFilter = document.getElementById('typeFilter').value;

        filteredData = currentData.filter(item => {
            const matchesSearch = item.guest.toLowerCase().includes(searchTerm) ||
                                  item.room.toString().includes(searchTerm);
            const matchesStatus = statusFilter === 'all' || item.status === statusFilter;
            const matchesType = typeFilter === 'all' || item.type === typeFilter;
            return matchesSearch && matchesStatus && matchesType;
        });

        applySort();
        currentPage = 1;
        updateTableDisplay();
    }

    function applySort() {
        const sortBy = document.getElementById('sortSelect').value;
        filteredData.sort((a, b) => {
            switch(sortBy) {
                case 'dateNew': return new Date(b.date) - new Date(a.date);
                case 'dateOld': return new Date(a.date) - new Date(b.date);
                case 'priceHigh': return b.price - a.price;
                case 'priceLow': return a.price - b.price;
                case 'guest': return a.guest.localeCompare(b.guest);
                default: return 0;
            }
        });
    }

    document.getElementById('searchInput').addEventListener('input', applyFilters);
    document.getElementById('statusFilter').addEventListener('change', applyFilters);
    document.getElementById('typeFilter').addEventListener('change', applyFilters);
    document.getElementById('sortSelect').addEventListener('change', function() { applyFilters(); });

    function resetFilters() {
        document.getElementById('searchInput').value = '';
        document.getElementById('statusFilter').value = 'all';
        document.getElementById('typeFilter').value = 'all';
        document.getElementById('sortSelect').value = 'dateNew';
        applyFilters();
    }

    function cancelBooking(id, guestName) {
        cancelId = id;
        document.getElementById('cancelGuestName').textContent = guestName;
        new bootstrap.Modal(document.getElementById('cancelModal')).show();
    }

    document.getElementById('confirmCancel').addEventListener('click', function() {
        if (cancelId) {
            const row = document.querySelector(`#bookingsTable tbody tr[data-id="${cancelId}"]`);
            if (row) {
                const statusSpan = row.querySelector('td:nth-child(10) span');
                statusSpan.className = 'badge bg-danger';
                statusSpan.textContent = 'Отменено';
                row.dataset.status = 'cancelled';
                alert(`Бронирование #${cancelId} отменено`);
            }
        }
        bootstrap.Modal.getInstance(document.getElementById('cancelModal')).hide();
        applyFilters();
    });

    initData();
</script>