@{
    ViewData["Title"] = "Редактирование гостя";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Получаем ID гостя из URL -->
@{
    var guest = new
    {
        Id = 1,
        LastName = "Иванов",
        FirstName = "Иван",
        MiddleName = "Иванович",
        PassportSeries = "1234",
        PassportNumber = "567890",
        Citizenship = "РФ",
        Phone = "+7 (999) 123-45-67",
        Email = "ivanov@mail.ru",
        BirthDate = "1985-06-15",
        RegistrationAddress = "г. Москва, ул. Цветочная, д. 10, кв. 25",
        Notes = "Предпочитает номера с видом на горы, вегетарианец"
    };
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="quick-actions-card">
                <h2 class="quick-actions-title">
                    <i class="bi bi-pencil-square"></i> Редактирование гостя
                </h2>

                <form id="guestForm" onsubmit="return submitForm(event)">
                    <input type="hidden" id="GuestId" value="@guest.Id" />

                    <!-- Основная информация -->
                    <h5 class="mb-3" style="color: #721e1e;">
                        <i class="bi bi-person-badge"></i> Личные данные
                    </h5>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="LastName" class="form-label fw-bold">
                                Фамилия <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="LastName" class="form-control" 
                                   value="@guest.LastName" placeholder="Иванов" required />
                            <div class="invalid-feedback">Введите фамилию (минимум 2 символа)</div>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label for="FirstName" class="form-label fw-bold">
                                Имя <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="FirstName" class="form-control" 
                                   value="@guest.FirstName" placeholder="Иван" required />
                            <div class="invalid-feedback">Введите имя (минимум 2 символа)</div>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label for="MiddleName" class="form-label">Отчество</label>
                            <input type="text" id="MiddleName" class="form-control" 
                                   value="@guest.MiddleName" placeholder="Иванович" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="PassportSeries" class="form-label fw-bold">
                                Серия паспорта <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="PassportSeries" class="form-control" 
                                   value="@guest.PassportSeries" placeholder="1234" maxlength="10" required />
                            <div class="invalid-feedback">Введите серию паспорта (4-10 символов)</div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="PassportNumber" class="form-label fw-bold">
                                Номер паспорта <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="PassportNumber" class="form-control" 
                                   value="@guest.PassportNumber" placeholder="567890" maxlength="20" required />
                            <div class="invalid-feedback">Введите номер паспорта (6-20 символов)</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="Citizenship" class="form-label fw-bold">Гражданство</label>
                        <select id="Citizenship" class="form-select">
                            <option value="РФ" selected="@(guest.Citizenship == "РФ")">Российская Федерация</option>
                            <option value="Беларусь" selected="@(guest.Citizenship == "Беларусь")">Беларусь</option>
                            <option value="Казахстан" selected="@(guest.Citizenship == "Казахстан")">Казахстан</option>
                            <option value="Армения" selected="@(guest.Citizenship == "Армения")">Армения</option>
                            <option value="Киргизия" selected="@(guest.Citizenship == "Киргизия")">Киргизия</option>
                            <option value="Узбекистан" selected="@(guest.Citizenship == "Узбекистан")">Узбекистан</option>
                            <option value="Таджикистан" selected="@(guest.Citizenship == "Таджикистан")">Таджикистан</option>
                        </select>
                    </div>

                    <!-- Контактные данные -->
                    <h5 class="mt-4 mb-3" style="color: #721e1e;">
                        <i class="bi bi-envelope"></i> Контактные данные
                    </h5>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="Phone" class="form-label fw-bold">
                                Телефон <span class="text-danger">*</span>
                            </label>
                            <input type="tel" id="Phone" class="form-control" 
                                   value="@guest.Phone" placeholder="+7 (999) 123-45-67" required />
                            <div class="invalid-feedback">Введите корректный номер телефона</div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="Email" class="form-label">Email</label>
                            <input type="email" id="Email" class="form-control" 
                                   value="@guest.Email" placeholder="ivanov@mail.com" />
                            <div class="invalid-feedback">Введите корректный email</div>
                        </div>
                    </div>

                    <!-- Дополнительная информация -->
                    <h5 class="mt-4 mb-3" style="color: #721e1e;">
                        <i class="bi bi-info-circle"></i> Дополнительная информация
                    </h5>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="BirthDate" class="form-label">Дата рождения</label>
                            <input type="date" id="BirthDate" class="form-control" 
                                   value="@guest.BirthDate" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="RegistrationAddress" class="form-label">Адрес регистрации</label>
                            <input type="text" id="RegistrationAddress" class="form-control" 
                                   value="@guest.RegistrationAddress" placeholder="г. Москва, ул. Примерная, д. 1, кв. 1" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="Notes" class="form-label">Примечания</label>
                        <textarea id="Notes" class="form-control" rows="3" 
                                  placeholder="Особые пожелания, заметки о госте...">@guest.Notes</textarea>
                    </div>

                    <!-- Предупреждение о дубликатах -->
                    <div class="alert alert-warning" id="duplicateWarning" style="display: none;">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        Гость с таким паспортом уже существует в системе (возможно, это тот же гость)!
                    </div>

                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i>
                        Все поля, отмеченные звездочкой (<span class="text-danger">*</span>), обязательны для заполнения.
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a href="/Admin/Guests" class="action-btn action-btn-outline">
                            <i class="bi bi-arrow-left"></i> Отмена
                        </a>
                        <button type="submit" class="action-btn">
                            <i class="bi bi-save"></i> Сохранить изменения
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно успеха -->
<div class="modal fade" id="successModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background: #28a745; color: white;">
                <h5 class="modal-title">
                    <i class="bi bi-check-circle-fill"></i> Успех!
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <i class="bi bi-person-check" style="font-size: 4rem; color: #28a745;"></i>
                <h4 class="mt-3">Данные гостя обновлены!</h4>
                <p id="successMessage"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="action-btn action-btn-outline" data-bs-dismiss="modal">
                    Продолжить редактирование
                </button>
                <a href="/Admin/Guests" class="action-btn">
                    К списку гостей
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    // Проверка на существующего гостя (имитация)
    const existingPassports = ['1234 567890', '5678 123456'];
    let originalPassport = '@guest.PassportSeries @guest.PassportNumber';

    function checkDuplicate() {
        const series = document.getElementById('PassportSeries').value;
        const number = document.getElementById('PassportNumber').value;
        const passportFull = `${series} ${number}`;
        
        const warning = document.getElementById('duplicateWarning');
        // Если паспорт изменился и такой уже существует
        if (passportFull !== originalPassport && existingPassports.includes(passportFull)) {
            warning.style.display = 'block';
            return true;
        } else {
            warning.style.display = 'none';
            return false;
        }
    }

    function validateForm() {
        let isValid = true;

        // Валидация фамилии
        const lastName = document.getElementById('LastName');
        if (lastName.value.trim().length < 2) {
            lastName.classList.add('is-invalid');
            isValid = false;
        } else {
            lastName.classList.remove('is-invalid');
        }

        // Валидация имени
        const firstName = document.getElementById('FirstName');
        if (firstName.value.trim().length < 2) {
            firstName.classList.add('is-invalid');
            isValid = false;
        } else {
            firstName.classList.remove('is-invalid');
        }

        // Валидация серии паспорта
        const passportSeries = document.getElementById('PassportSeries');
        if (passportSeries.value.trim().length < 4 || passportSeries.value.trim().length > 10) {
            passportSeries.classList.add('is-invalid');
            isValid = false;
        } else {
            passportSeries.classList.remove('is-invalid');
        }

        // Валидация номера паспорта
        const passportNumber = document.getElementById('PassportNumber');
        if (passportNumber.value.trim().length < 6 || passportNumber.value.trim().length > 20) {
            passportNumber.classList.add('is-invalid');
            isValid = false;
        } else {
            passportNumber.classList.remove('is-invalid');
        }

        // Валидация телефона
        const phone = document.getElementById('Phone');
        const phonePattern = /^[\+\d\s\-\(\)]{10,}$/;
        if (!phonePattern.test(phone.value.trim())) {
            phone.classList.add('is-invalid');
            isValid = false;
        } else {
            phone.classList.remove('is-invalid');
        }

        // Валидация email (если заполнен)
        const email = document.getElementById('Email');
        if (email.value.trim() !== '') {
            const emailPattern = /^[^\s@@]+@@([^\s@@.,]+\.)+[^\s@@.,]{2,}$/;
            if (!emailPattern.test(email.value)) {
                email.classList.add('is-invalid');
                isValid = false;
            } else {
                email.classList.remove('is-invalid');
            }
        }

        // Проверка на дубликат
        if (checkDuplicate()) {
            isValid = false;
        }

        return isValid;
    }

    function submitForm(event) {
        event.preventDefault();

        if (!validateForm()) {
            return false;
        }

        // Формируем сообщение
        const lastName = document.getElementById('LastName').value;
        const firstName = document.getElementById('FirstName').value;
        const middleName = document.getElementById('MiddleName').value;
        const fullName = `${lastName} ${firstName} ${middleName}`.trim();
        const guestId = document.getElementById('GuestId').value;

        document.getElementById('successMessage').innerHTML = `Данные гостя <strong>${fullName}</strong> (ID: ${guestId}) успешно обновлены.`;

        // Показываем модальное окно
        const successModal = new bootstrap.Modal(document.getElementById('successModal'));
        successModal.show();

        // Обновляем оригинальный паспорт для проверки дубликатов
        const series = document.getElementById('PassportSeries').value;
        const number = document.getElementById('PassportNumber').value;
        originalPassport = `${series} ${number}`;

        return false;
    }

    // Обработчики для проверки дубликатов в реальном времени
    document.getElementById('PassportSeries').addEventListener('input', checkDuplicate);
    document.getElementById('PassportNumber').addEventListener('input', checkDuplicate);

    // Установка маски для телефона
    document.getElementById('Phone').addEventListener('input', function(e) {
        let value = e.target.value.replace(/\D/g, '');
        if (value.length > 11) value = value.slice(0, 11);
        
        let formatted = '';
        if (value.length > 0) {
            formatted = '+7 ';
            if (value.length > 1) {
                formatted += '(' + value.slice(1, 4);
            }
            if (value.length >= 5) {
                formatted += ') ' + value.slice(4, 7);
            }
            if (value.length >= 8) {
                formatted += '-' + value.slice(7, 9);
            }
            if (value.length >= 10) {
                formatted += '-' + value.slice(9, 11);
            }
        }
        e.target.value = formatted;
    });

    // Убираем маску при фокусе для удобства редактирования (опционально)
    document.getElementById('Phone').addEventListener('focus', function(e) {
        let value = e.target.value.replace(/\D/g, '');
        if (value.startsWith('7') && value.length === 11) {
            e.target.value = value;
        }
    });
</script>