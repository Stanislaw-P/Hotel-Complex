@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Статические данные гостя (имитация данных из БД) -->
@{
    var guest = new {
            Id = 1,
            LastName = "Иванов",
            FirstName = "Иван",
            MiddleName = "Иванович",
            PassportSeries = "1234",
            PassportNumber = "567890",
            Citizenship = "РФ",
            Phone = "+7 (999) 123-45-67",
            Email = "ivanov@mail.ru",
            BirthDate = "1985-06-15",
            RegistrationAddress = "г. Москва, ул. Цветочная, д. 10, кв. 25",
            Notes = "Предпочитает номера с видом на горы, вегетарианец",
            CreatedAt = "2024-05-10",
            BookingsCount = 2};

    // История бронирований гостя
    var bookings = new[]
    {
        new { Id = 101, RoomNumber = 101, CheckIn = "2024-05-10", CheckOut = "2024-05-15", Status = "completed", TotalPrice = 12500 },
        new { Id = 102, RoomNumber = 201, CheckIn = "2024-06-20", CheckOut = "2024-06-25", Status = "confirmed", TotalPrice = 20000 }
    };
}

<div class="container py-4">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <!-- Заголовок -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="section-title mb-0">
                    <i class="bi bi-person-badge"></i> Карточка гостя
                </h2>
                <div>
                    <a href="/Admin/Guests/Edit" class="action-btn me-2">
                        <i class="bi bi-pencil"></i> Редактировать
                    </a>
                    <a href="/Admin/Guests" class="action-btn action-btn-outline">
                        <i class="bi bi-arrow-left"></i> Назад
                    </a>
                </div>
            </div>

            <!-- Основная информация -->
            <div class="quick-actions-card mb-4">
                <h4 class="quick-actions-title">
                    <i class="bi bi-person-circle"></i> Основная информация
                </h4>

                <div class="row">
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr>
                                <th style="width: 40%; color: #721e1e;">ID гостя:</th>
                                <td><strong>#@guest.Id</strong></td>
                            </tr>
                            <tr>
                                <th style="color: #721e1e;">Фамилия:</th>
                                <td>@guest.LastName</td>
                            </tr>
                            <tr>
                                <th style="color: #721e1e;">Имя:</th>
                                <td>@guest.FirstName</td>
                            </tr>
                            <tr>
                                <th style="color: #721e1e;">Отчество:</th>
                                <td>@(guest.MiddleName ?? "—")</td>
                            </tr>
                            <tr>
                                <th style="color: #721e1e;">Полное имя:</th>
                                <td><strong>@guest.LastName @guest.FirstName @guest.MiddleName</strong></td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr>
                                <th style="width: 40%; color: #721e1e;">Дата регистрации:</th>
                                <td>@DateTime.Parse(guest.CreatedAt).ToString("dd.MM.yyyy")</td>
                            </tr>
                            <tr>
                                <th style="color: #721e1e;">Количество броней:</th>
                                <td>
                                    <span class="badge" style="background: #721e1e; color: #e2d797;">
                                        @guest.BookingsCount бронирований
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <th style="color: #721e1e;">Статус:</th>
                                <td>
                                    @if (guest.BookingsCount > 0)
                                    {
                                        <span class="badge bg-success">Активный</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Нет броней</span>
                                    }
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Паспортные данные -->
            <div class="quick-actions-card mb-4">
                <h4 class="quick-actions-title">
                    <i class="bi bi-passport"></i> Паспортные данные
                </h4>

                <div class="row">
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr>
                                <th style="width: 40%; color: #721e1e;">Серия паспорта:</th>
                                <td>@guest.PassportSeries</td>
                            </tr>
                            <tr>
                                <th style="color: #721e1e;">Номер паспорта:</th>
                                <td>@guest.PassportNumber</td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr>
                                <th style="width: 40%; color: #721e1e;">Гражданство:</th>
                                <td>@guest.Citizenship</td>
                            </tr>
                            <tr>
                                <th style="color: #721e1e;">Дата рождения:</th>
                                <td>@(guest.BirthDate != null ? DateTime.Parse(guest.BirthDate).ToString("dd.MM.yyyy") : "—")</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Контактные данные -->
            <div class="quick-actions-card mb-4">
                <h4 class="quick-actions-title">
                    <i class="bi bi-envelope"></i> Контактные данные
                </h4>

                <div class="row">
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr>
                                <th style="width: 40%; color: #721e1e;">Телефон:</th>
                                <td>
                                    <a href="tel:@guest.Phone" style="color: #721e1e;">
                                        <i class="bi bi-telephone-fill me-1"></i> @guest.Phone
                                    </a>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr>
                                <th style="width: 40%; color: #721e1e;">Email:</th>
                                <td>
                                    @if (!string.IsNullOrEmpty(guest.Email))
                                    {
                                        <a href="mailto:@guest.Email" style="color: #721e1e;">
                                            <i class="bi bi-envelope-fill me-1"></i> @guest.Email
                                        </a>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Адрес и примечания -->
            <div class="quick-actions-card mb-4">
                <h4 class="quick-actions-title">
                    <i class="bi bi-geo-alt"></i> Адрес и примечания
                </h4>

                <div class="mb-3">
                    <label class="fw-bold" style="color: #721e1e;">Адрес регистрации:</label>
                    <p class="mt-2">@(guest.RegistrationAddress ?? "—")</p>
                </div>

                <div>
                    <label class="fw-bold" style="color: #721e1e;">Примечания:</label>
                    <p class="mt-2">@(guest.Notes ?? "—")</p>
                </div>
            </div>

            <!-- История бронирований -->
            <div class="quick-actions-card">
                <h4 class="quick-actions-title">
                    <i class="bi bi-calendar-check"></i> История бронирований
                </h4>

                @if (bookings.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-custom">
                            <thead>
                                <tr>
                                    <th>№ брони</th>
                                    <th>Номер</th>
                                    <th>Дата заезда</th>
                                    <th>Дата выезда</th>
                                    <th>Статус</th>
                                    <th>Сумма</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var booking in bookings)
                                {
                                    <tr>
                                        <td>#@booking.Id</td>
                                        <td>№@booking.RoomNumber</td>
                                        <td>@DateTime.Parse(booking.CheckIn).ToString("dd.MM.yyyy")</td>
                                        <td>@DateTime.Parse(booking.CheckOut).ToString("dd.MM.yyyy")</td>
                                        <td>
                                            @if (booking.Status == "completed")
                                            {
                                                <span class="badge bg-secondary">Завершено</span>
                                            }
                                            else if (booking.Status == "confirmed")
                                            {
                                                <span class="badge bg-success">Подтверждено</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Отменено</span>
                                            }
                                        </td>
                                        <td>@booking.TotalPrice.ToString("N0") ₽</td>
                                        <td>
                                            <a href="/Admin/Bookings/Details/@booking.Id" class="btn btn-sm btn-info">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-calendar-x" style="font-size: 2rem;"></i>
                        <p class="mt-2">У гостя пока нет бронирований</p>
                    </div>
                }

                <div class="mt-3 text-end">
                    <a href="/Admin/Bookings/Create?guestId=@guest.Id" class="action-btn">
                        <i class="bi bi-plus-circle"></i> Создать бронирование
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Функция для копирования текста (опционально)
    function copyToClipboard(text) {
        navigator.clipboard.writeText(text);
        alert('Скопировано в буфер обмена');
    }
</script>