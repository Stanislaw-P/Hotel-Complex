@{
    ViewData["Title"] = "Управление номерами";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Статические данные номеров -->
@{
    var rooms = new[]
    {
        new { Id = 101, RoomNumber = 101, Floor = 1, RoomType = "Стандарт", Capacity = 2, BasePrice = 2500, Status = "free", Description = "Уютный стандартный номер с видом на горы", LastCleaning = "2024-05-10" },
        new { Id = 102, RoomNumber = 102, Floor = 1, RoomType = "Стандарт", Capacity = 2, BasePrice = 2500, Status = "free", Description = "Светлый номер с большой кроватью", LastCleaning = "2024-05-12" },
        new { Id = 103, RoomNumber = 103, Floor = 1, RoomType = "Стандарт+", Capacity = 2, BasePrice = 3000, Status = "occupied", Description = "Улучшенный стандарт с дополнительным пространством", LastCleaning = "2024-05-08" },
        new { Id = 104, RoomNumber = 104, Floor = 1, RoomType = "Стандарт", Capacity = 2, BasePrice = 2500, Status = "cleaning", Description = "Номер с видом во двор", LastCleaning = "2024-05-13" },
        new { Id = 201, RoomNumber = 201, Floor = 2, RoomType = "Полулюкс", Capacity = 3, BasePrice = 4000, Status = "free", Description = "Просторный полулюкс с гостиной зоной", LastCleaning = "2024-05-11" },
        new { Id = 202, RoomNumber = 202, Floor = 2, RoomType = "Полулюкс", Capacity = 3, BasePrice = 4000, Status = "free", Description = "Семейный полулюкс с двумя спальнями", LastCleaning = "2024-05-09" },
        new { Id = 203, RoomNumber = 203, Floor = 2, RoomType = "Полулюкс+", Capacity = 3, BasePrice = 4500, Status = "occupied", Description = "Полулюкс премиум с видом на горы", LastCleaning = "2024-05-07" },
        new { Id = 204, RoomNumber = 204, Floor = 2, RoomType = "Полулюкс", Capacity = 3, BasePrice = 4000, Status = "repair", Description = "Требуется косметический ремонт", LastCleaning = "2024-04-28" },
        new { Id = 301, RoomNumber = 301, Floor = 3, RoomType = "Люкс", Capacity = 4, BasePrice = 6500, Status = "free", Description = "Роскошный люкс с панорамным видом", LastCleaning = "2024-05-12" },
        new { Id = 302, RoomNumber = 302, Floor = 3, RoomType = "Люкс", Capacity = 4, BasePrice = 7000, Status = "occupied", Description = "Люкс с джакузи и террасой", LastCleaning = "2024-05-10" },
        new { Id = 401, RoomNumber = 401, Floor = 4, RoomType = "Апартаменты", Capacity = 5, BasePrice = 10000, Status = "free", Description = "Двухуровневые апартаменты с камином", LastCleaning = "2024-05-11" },
        new { Id = 402, RoomNumber = 402, Floor = 4, RoomType = "Апартаменты", Capacity = 5, BasePrice = 12000, Status = "free", Description = "Президентские апартаменты с сауной", LastCleaning = "2024-05-09" }
    };
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="section-title mb-0">
            <i class="bi bi-door-open"></i> Управление номерами
        </h2>
        <a href="/Admin/Rooms/Create" class="action-btn">
            <i class="bi bi-plus-circle"></i> Добавить номер
        </a>
    </div>

    <!-- Карточки статистики -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="card-header">
                    <i class="bi bi-building"></i> Всего номеров
                </div>
                <div class="card-body text-center">
                    <div class="stat-number">@rooms.Length</div>
                    <div class="stat-label">всего</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="card-header" style="background: linear-gradient(135deg, #28a745, #1e7e34);">
                    <i class="bi bi-check-circle"></i> Свободны
                </div>
                <div class="card-body text-center">
                    <div class="stat-number" style="color: #28a745;">@rooms.Count(r => r.Status == "free")</div>
                    <div class="stat-label">свободны</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="card-header" style="background: linear-gradient(135deg, #dc3545, #b02a37);">
                    <i class="bi bi-person"></i> Заняты
                </div>
                <div class="card-body text-center">
                    <div class="stat-number" style="color: #dc3545;">@rooms.Count(r => r.Status == "occupied")</div>
                    <div class="stat-label">заняты</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="card-header" style="background: linear-gradient(135deg, #ffc107, #d39e00);">
                    <i class="bi bi-tools"></i> Обслуживание
                </div>
                <div class="card-body text-center">
                    <div class="stat-number" style="color: #d39e00;">@rooms.Count(r => r.Status == "cleaning" || r.Status == "repair")</div>
                    <div class="stat-label">на уборке/ремонте</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Фильтры и поиск -->
    <div class="quick-actions-card mb-4">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label fw-bold">
                    <i class="bi bi-search"></i> Поиск
                </label>
                <input type="text" id="searchInput" class="form-control" placeholder="Номер, тип...">
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">
                    <i class="bi bi-funnel"></i> Статус
                </label>
                <select id="statusFilter" class="form-select">
                    <option value="all">Все статусы</option>
                    <option value="free">Свободны</option>
                    <option value="occupied">Заняты</option>
                    <option value="cleaning">На уборке</option>
                    <option value="repair">На ремонте</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">
                    <i class="bi bi-hash"></i> Этаж
                </label>
                <select id="floorFilter" class="form-select">
                    <option value="all">Все этажи</option>
                    <option value="1">1 этаж</option>
                    <option value="2">2 этаж</option>
                    <option value="3">3 этаж</option>
                    <option value="4">4 этаж</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">
                    <i class="bi bi-tag"></i> Тип номера
                </label>
                <select id="typeFilter" class="form-select">
                    <option value="all">Все типы</option>
                    <option value="Стандарт">Стандарт</option>
                    <option value="Полулюкс">Полулюкс</option>
                    <option value="Люкс">Люкс</option>
                    <option value="Апартаменты">Апартаменты</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="action-btn-outline w-100" onclick="resetFilters()">
                    <i class="bi bi-arrow-repeat"></i> Сбросить фильтры
                </button>
            </div>
        </div>
    </div>

    <!-- Карточки номеров -->
    <div class="row" id="roomsContainer">
        @foreach (var room in rooms)
        {
            <div class="col-md-6 col-lg-4 mb-4 room-card"
                 data-number="@room.RoomNumber"
                 data-type="@room.RoomType"
                 data-status="@room.Status"
                 data-floor="@room.Floor">
                <div class="card h-100" style="border: none; border-radius: 15px; overflow: hidden; box-shadow: 0 5px 15px rgba(0,0,0,0.1);">
                    <div class="card-header" style="background: linear-gradient(135deg, #721e1e, #4d1414); color: #e2d797; padding: 15px;">
                        <div class="d-flex justify-content-between align-items-center">
                            <h4 class="mb-0">Номер №@room.RoomNumber</h4>
                            @if (room.Status == "free")
                            {
                                <span class="badge bg-success">Свободен</span>
                            }
                            else if (room.Status == "occupied")
                            {
                                <span class="badge bg-danger">Занят</span>
                            }
                            else if (room.Status == "cleaning")
                            {
                                <span class="badge bg-warning text-dark">На уборке</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">На ремонте</span>
                            }
                        </div>
                    </div>
                    <div class="card-body" style="background: white;">
                        <div class="mb-3">
                            <span class="badge" style="background: #721e1e; color: #e2d797;">@room.RoomType</span>
                            <span class="badge bg-secondary ms-2"><i class="bi bi-arrow-up"></i> @room.Floor этаж</span>
                            <span class="badge bg-secondary ms-2"><i class="bi bi-people"></i> @room.Capacity чел.</span>
                        </div>
                        <p class="text-muted mb-3">@room.Description</p>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between">
                                <span><i class="bi bi-wifi"></i> Wi-Fi</span>
                                <span><i class="bi bi-tv"></i> Телевизор</span>
                                <span><i class="bi bi-droplet"></i> Душ</span>
                                <span><i class="bi bi-snow"></i> Кондиционер</span>
                            </div>
                        </div>
                        <div class="border-top pt-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted">Цена за сутки</small>
                                    <h4 class="mb-0" style="color: #721e1e;">@room.BasePrice.ToString("N0") ₽</h4>
                                </div>
                                <div>
                                    <a href="/Admin/Rooms/Details/@room.Id" class="btn btn-sm btn-info me-1" title="Просмотр">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="/Admin/Rooms/Edit/@room.Id" class="btn btn-sm btn-warning me-1" title="Редактировать">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-danger" title="Удалить" onclick="deleteRoom(@room.Id, @room.RoomNumber)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer" style="background: #f8f9fa;">
                        <small class="text-muted"><i class="bi bi-calendar"></i> Последняя уборка: @DateTime.Parse(room.LastCleaning).ToString("dd.MM.yyyy")</small>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Если нет результатов -->
    <div id="noResults" class="text-center py-5" style="display: none;">
        <i class="bi bi-emoji-frown" style="font-size: 4rem; color: #721e1e;"></i>
        <h3 class="mt-3">Нет номеров</h3>
        <p class="text-muted">По вашему запросу не найдено номеров</p>
        <button onclick="resetFilters()" class="action-btn mt-3">
            <i class="bi bi-arrow-repeat"></i> Сбросить фильтры
        </button>
    </div>
</div>

<!-- Модальное окно удаления -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background: #dc3545; color: white;">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle-fill"></i> Удаление номера
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Вы уверены, что хотите удалить номер <strong id="deleteRoomNumber"></strong>?</p>
                <p class="text-danger">Это действие нельзя отменить. Все связанные бронирования будут удалены.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="action-btn action-btn-outline" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="action-btn" style="background: #dc3545;" id="confirmDelete">Удалить</button>
            </div>
        </div>
    </div>
</div>

<script>
    let deleteId = null;

    function filterRooms() {
        const searchTerm = document.getElementById('searchInput').value.toLowerCase();
        const statusFilter = document.getElementById('statusFilter').value;
        const floorFilter = document.getElementById('floorFilter').value;
        const typeFilter = document.getElementById('typeFilter').value;

        const cards = document.querySelectorAll('.room-card');
        let hasVisible = false;

        cards.forEach(card => {
            const number = card.dataset.number;
            const type = card.dataset.type;
            const status = card.dataset.status;
            const floor = card.dataset.floor;

            const matchesSearch = number.toString().includes(searchTerm) ||
                                  type.toLowerCase().includes(searchTerm);
            const matchesStatus = statusFilter === 'all' || status === statusFilter;
            const matchesFloor = floorFilter === 'all' || floor === floorFilter;
            const matchesType = typeFilter === 'all' || type === typeFilter;

            if (matchesSearch && matchesStatus && matchesFloor && matchesType) {
                card.style.display = '';
                hasVisible = true;
            } else {
                card.style.display = 'none';
            }
        });

        const noResults = document.getElementById('noResults');
        if (hasVisible) {
            noResults.style.display = 'none';
        } else {
            noResults.style.display = 'block';
        }
    }

    function resetFilters() {
        document.getElementById('searchInput').value = '';
        document.getElementById('statusFilter').value = 'all';
        document.getElementById('floorFilter').value = 'all';
        document.getElementById('typeFilter').value = 'all';
        filterRooms();
    }

    function deleteRoom(id, roomNumber) {
        deleteId = id;
        document.getElementById('deleteRoomNumber').textContent = '№' + roomNumber;
        new bootstrap.Modal(document.getElementById('deleteModal')).show();
    }

    document.getElementById('confirmDelete').addEventListener('click', function() {
        if (deleteId) {
            // Находим и удаляем карточку
            const card = document.querySelector(`.room-card[data-number="${deleteId}"]`);
            if (card) {
                card.remove();
                alert(`Номер ${deleteId} удален`);
            }
        }
        bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
        filterRooms();
    });

    document.getElementById('searchInput').addEventListener('input', filterRooms);
    document.getElementById('statusFilter').addEventListener('change', filterRooms);
    document.getElementById('floorFilter').addEventListener('change', filterRooms);
    document.getElementById('typeFilter').addEventListener('change', filterRooms);

    filterRooms();
</script>