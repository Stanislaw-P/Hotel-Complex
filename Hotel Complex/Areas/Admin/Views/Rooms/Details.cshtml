@{
    ViewData["Title"] = "Детали номера";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@{
    var room = new
    {
        Id = 101,
        RoomNumber = 101,
        Floor = 1,
        RoomType = "Стандарт",
        RoomTypeId = 1,
        Capacity = 2,
        BasePrice = 2500,
        Status = "free",
        Description = "Уютный стандартный номер с видом на горы",
        Amenities = new[] { "Wi-Fi", "Телевизор", "Душ", "Кондиционер" },
        LastCleaning = "2024-05-10",
        LastMaintenance = "2024-04-15",
        CreatedAt = "2024-01-15"
    };

    // Текущее бронирование (если номер занят)
    var currentBooking = room.Status == "occupied" ? new { GuestName = "Иванов Иван Иванович", CheckIn = "2024-05-10", CheckOut = "2024-05-15" } : null;
}

<div class="container py-4">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <!-- Заголовок -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="section-title mb-0">
                    <i class="bi bi-door-open"></i> Детали номера №@room.RoomNumber
                </h2>
                <div>
                    <a href="/Admin/Rooms/Edit/@room.Id" class="action-btn me-2">
                        <i class="bi bi-pencil"></i> Редактировать
                    </a>
                    <a href="/Admin/Rooms/Index" class="action-btn action-btn-outline">
                        <i class="bi bi-arrow-left"></i> Назад
                    </a>
                </div>
            </div>

            <!-- Статус баннер -->
            <div class="alert mb-4" style="background: @(room.Status == "free" ? "#d4edda" : room.Status == "occupied" ? "#f8d7da" : "#fff3cd"); border: none; border-radius: 15px;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <i class="bi bi-info-circle-fill me-2"></i>
                        <strong>Статус номера:</strong>
                        @if (room.Status == "free")
                        {
                            <span class="badge bg-success ms-2">Свободен</span>
                        }
                        else if (room.Status == "occupied")
                        {
                            <span class="badge bg-danger ms-2">Занят</span>
                        }
                        else if (room.Status == "cleaning")
                        {
                            <span class="badge bg-warning text-dark ms-2">На уборке</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary ms-2">На ремонте</span>
                        }
                    </div>
                    <div>
                        <small>Добавлен: @DateTime.Parse(room.CreatedAt).ToString("dd.MM.yyyy")</small>
                    </div>
                </div>
            </div>

            <!-- Основная информация -->
            <div class="quick-actions-card mb-4">
                <h4 class="quick-actions-title">
                    <i class="bi bi-info-circle"></i> Основная информация
                </h4>

                <div class="row">
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr>
                                <th style="width: 40%; color: #721e1e;">Номер комнаты:</th>
                                <td><strong>№@room.RoomNumber</strong></td>
                            </tr>
                            <tr>
                                <th style="color: #721e1e;">Этаж:</th>
                                <td>@room.Floor</td>
                            </tr>
                            <tr>
                                <th style="color: #721e1e;">Тип номера:</th>
                                <td>@room.RoomType</td>
                            </tr>
                            <tr>
                                <th style="color: #721e1e;">Вместимость:</th>
                                <td>@room.Capacity чел.</td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr>
                                <th style="width: 40%; color: #721e1e;">Цена за сутки:</th>
                                <td><strong>@room.BasePrice.ToString("N0") ₽</strong></td>
                            </tr>
                            <tr>
                                <th style="color: #721e1e;">ID типа:</th>
                                <td>#@room.RoomTypeId</td>
                            </tr>
                            <tr>
                                <th style="color: #721e1e;">Последняя уборка:</th>
                                <td>@DateTime.Parse(room.LastCleaning).ToString("dd.MM.yyyy")</td>
                            </tr>
                            <tr>
                                <th style="color: #721e1e;">Последний ремонт:</th>
                                <td>@DateTime.Parse(room.LastMaintenance).ToString("dd.MM.yyyy")</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Описание -->
            <div class="quick-actions-card mb-4">
                <h4 class="quick-actions-title">
                    <i class="bi bi-card-text"></i> Описание
                </h4>
                <p class="mb-0">@room.Description</p>
            </div>

            <!-- Удобства -->
            <div class="quick-actions-card mb-4">
                <h4 class="quick-actions-title">
                    <i class="bi bi-grid"></i> Удобства в номере
                </h4>
                <div class="row">
                    @foreach (var amenity in room.Amenities)
                    {
                        <div class="col-md-3 mb-2">
                            <i class="bi bi-check-circle-fill" style="color: #28a745;"></i> @amenity
                        </div>
                    }
                </div>
            </div>

            <!-- Текущее бронирование (если номер занят) -->
            @if (currentBooking != null)
            {
                <div class="quick-actions-card mb-4">
                    <h4 class="quick-actions-title">
                        <i class="bi bi-calendar-check"></i> Текущее бронирование
                    </h4>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="bg-light p-3 rounded">
                                <p class="mb-2"><strong>Гость:</strong> @currentBooking.GuestName</p>
                                <p class="mb-2"><strong>Даты:</strong> @DateTime.Parse(currentBooking.CheckIn).ToString("dd.MM.yyyy") - @DateTime.Parse(currentBooking.CheckOut).ToString("dd.MM.yyyy")</p>
                                <p class="mb-0"><strong>Количество ночей:</strong> @((DateTime.Parse(currentBooking.CheckOut) - DateTime.Parse(currentBooking.CheckIn)).Days)</p>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- История бронирований -->
            <div class="quick-actions-card">
                <h4 class="quick-actions-title">
                    <i class="bi bi-clock-history"></i> История бронирований
                </h4>

                <div class="table-responsive">
                    <table class="table table-custom">
                        <thead>
                            <tr>
                                <th>Дата заезда</th>
                                <th>Дата выезда</th>
                                <th>Гость</th>
                                <th>Сумма</th>
                                <th>Статус</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>10.05.2024</td>
                                <td>15.05.2024</td>
                                <td>Иванов Иван</td>
                                <td>12 500 ₽</td>
                                <td><span class="badge bg-secondary">Завершено</span></td>
                                <td>
                                    <a href="/Admin/Bookings/Details/1001" class="btn btn-sm btn-info">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                            <tr>
                                <td>01.03.2024</td>
                                <td>05.03.2024</td>
                                <td>Петрова Анна</td>
                                <td>10 000 ₽</td>
                                <td><span class="badge bg-secondary">Завершено</span></td>
                                <td>
                                    <a href="/Admin/Bookings/Details/1002" class="btn btn-sm btn-info">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>